              </g>
              <!-- Otras provincias -->
              <g fill="#F7F3EC" font-family="Fraunces" font-size="14" font-style="italic" text-anchor="middle">
                <circle cx="320" cy="280" r="6" fill="#F7F3EC" opacity="0.7"/>
                <text x="320" y="310" opacity="0.7">Córdoba</text>

                <circle cx="200" cy="320" r="6" fill="#F7F3EC" opacity="0.7"/>
                <text x="200" y="350" opacity="0.7">Sevilla</text>

                <circle cx="120" cy="380" r="6" fill="#F7F3EC" opacity="0.7"/>
                <text x="120" y="410" opacity="0.7">Huelva</text>

