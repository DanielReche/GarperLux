              </g>

              <!-- Línea decorativa -->
              <line x1="430" y1="240" x2="320" y2="280" stroke="rgba(255,200,120,0.3)" stroke-width="1" stroke-dasharray="3,3"/>
              <line x1="430" y1="240" x2="500" y2="320" stroke="rgba(255,200,120,0.3)" stroke-width="1" stroke-dasharray="3,3"/>
            </svg>

            <!-- Leyenda flotante -->
            <div class="absolute bottom-5 left-5 bg-paper text-ink text-xs font-mono px-3 py-2 rounded-md">
              ● Sede principal · Las Lagunillas
