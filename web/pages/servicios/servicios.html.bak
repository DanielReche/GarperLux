              <!-- Forma global Andalucía simplificada (no precisa, decorativa) -->
              <path d="M 100 250 Q 80 280 100 320 L 130 360 Q 150 400 200 420 L 280 450 Q 350 470 420 450 L 500 430 Q 580 420 640 380 L 700 340 Q 730 300 720 260 L 700 220 Q 670 200 620 200 L 540 220 Q 470 230 400 220 L 320 200 Q 250 195 180 215 Q 130 230 100 250 Z" fill="rgba(255,200,120,0.06)" stroke="rgba(255,200,120,0.3)" stroke-width="1.5"/>

              <!-- Provincias -->
