                <circle cx="430" cy="240" r="14" fill="#E8A545" />
                <circle cx="430" cy="240" r="22" fill="none" stroke="#E8A545" stroke-width="1" opacity="0.5">
                  <animate attributeName="r" values="14;28;14" dur="2s" repeatCount="indefinite"/>
