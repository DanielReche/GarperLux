<!DOCTYPE html>
<html lang="es">
<head>
  <base href="/.">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Solicitar técnico · GarperLux</title>
  <meta name="description" content="Pide un instalador autorizado en 5 pasos guiados. Respuesta en menos de 4 horas, presupuesto sin compromiso." />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = { theme: { extend: {
      colors: { ink:'#0B0D12','ink-soft':'#1C1F26',graphite:'#40454F',paper:'#F7F3EC','paper-2':'#EFE9DE','paper-3':'#E4DCCA',line:'#E5DED0',filament:'#E8A545','filament-glow':'#FFC878',copper:'#B8753A',electric:'#1E3A8A',stock:'#16A34A',warn:'#DC2626',caution:'#D97706' },
      fontFamily: { serif:['Fraunces','Georgia','serif'], sans:['Inter','system-ui','sans-serif'], mono:['JetBrains Mono','monospace'] },
    }}};
  </script>
  <link rel="stylesheet" href="/.assets/css/styles.css" />

  <style>
    /* STEPPER */
    body { min-height: 100vh; display: flex; flex-direction: column; }
    .step { display: none; }
    .step.is-active { display: block; animation: fadeStep .35s ease both; }
    @keyframes fadeStep { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }

    .opt-card {
      display: flex; align-items: flex-start; gap: 1rem;
      padding: 1.25rem 1.4rem; border: 1.5px solid var(--line);
      border-radius: 14px; cursor: pointer; transition: all .2s ease;
      background: white;
    }
    .opt-card:hover { border-color: var(--graphite); }
    .opt-card.is-selected { border-color: var(--ink); background: var(--ink); color: var(--paper); box-shadow: 0 12px 24px -12px rgba(11,13,18,0.3); }
    .opt-card.is-selected .opt-icon { background: var(--filament); color: var(--ink); }
    .opt-card.is-selected .opt-meta { color: rgba(247,243,236,0.6); }
    .opt-icon { width: 48px; height: 48px; border-radius: 12px; background: var(--paper-2); display: grid; place-items: center; flex-shrink: 0; transition: all .2s; }

    .field-input {
      width: 100%; padding: 0.95rem 1.1rem;
      background: white; border: 1.5px solid var(--line);
      border-radius: 12px; font-size: 16px; color: var(--ink);
      transition: border-color .2s;
    }
    .field-input:focus { outline: none; border-color: var(--ink); }
    .field-input::placeholder { color: rgba(64,69,79,0.5); }
    textarea.field-input { resize: vertical; min-height: 140px; line-height: 1.55; }

    /* Progress bar segmentada */
    .seg { flex: 1; height: 4px; background: var(--paper-3); border-radius: 999px; transition: background .3s; }
    .seg.is-done { background: var(--filament); }
    .seg.is-current { background: var(--ink); }

    /* Drag&drop */
    .dropzone {
      border: 2px dashed var(--line); border-radius: 14px; padding: 2.5rem 1.5rem;
      text-align: center; cursor: pointer; transition: all .2s;
      background: var(--paper-2);
    }
    .dropzone:hover { border-color: var(--ink); background: white; }
  </style>
</head>

<body class="bg-paper text-ink">

  <!-- HEADER MINIMAL -->
  <header class="border-b border-line bg-paper sticky top-0 z-30">
    <div class="container-x flex items-center justify-between py-4">
      <a href="/.index.html" class="flex items-center gap-3">
        <img src="/.assets/img/logo.svg" alt="GarperLux" class="h-8 w-auto"/>
      </a>

      <!-- Progress segmentada -->
      <div class="hidden md:flex items-center gap-2 w-[420px] mx-8">
        <span class="font-mono text-xs text-graphite shrink-0">Paso <span data-current-step>1</span> / 6</span>
        <div class="flex-1 flex gap-1">
          <div class="seg is-current" data-seg="1"></div>
          <div class="seg" data-seg="2"></div>
          <div class="seg" data-seg="3"></div>
          <div class="seg" data-seg="4"></div>
          <div class="seg" data-seg="5"></div>
          <div class="seg" data-seg="6"></div>
        </div>
      </div>

      <a href="/.index.html" class="text-sm text-graphite hover:text-ink flex items-center gap-2">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 6 6 18M6 6l12 12"/></svg>
        <span class="hidden sm:inline">Salir</span>
      </a>
    </div>
    <!-- Progress mobile -->
    <div class="md:hidden h-1 bg-paper-3">
      <div id="mobile-progress" class="h-full bg-filament transition-all" style="width: 16.66%"></div>
    </div>
  </header>

  <!-- ============ STEPPER LAYOUT ============ -->
  <main class="flex-1 grid lg:grid-cols-[1fr_360px]">

    <!-- ============ MAIN CONTENT ============ -->
    <div class="container-x py-12 md:py-16 lg:py-20">
      <div class="max-w-2xl">

        <!-- ===== STEP 1: ¿Qué necesitas ===== -->
        <section class="step is-active" data-step="1">
          <div class="eyebrow text-copper mb-4">Paso 01 de 06</div>
          <h2 class="font-serif font-medium leading-[1.05] tracking-[-0.015em] mb-3" style="font-size: clamp(2rem, 4.5vw, 3.25rem);">
            ¿Qué te ha pasado?
          </h2>
          <p class="text-graphite text-lg mb-10">Elige la categoría que mejor describa lo que necesitas. Si dudas, "Avería" suele ser lo más habitual.</p>

          <div class="space-y-3">
            <label class="opt-card" data-opt="averia" data-step-field="tipo">
              <input type="radio" name="tipo" value="averia" class="sr-only"/>
              <div class="opt-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0zM12 9v4M12 17h.01"/></svg></div>
              <div class="flex-1">
                <h3 class="font-medium text-lg mb-0.5">Tengo una avería</h3>
                <p class="opt-meta text-sm text-graphite">Algo dejó de funcionar: salta el automático, parte sin luz, enchufes que no responden, ruidos extraños.</p>
              </div>
              <div class="opt-meta text-xs font-mono text-graphite shrink-0 mt-1">desde 65 €</div>
            </label>

            <label class="opt-card" data-opt="instalacion" data-step-field="tipo">
              <input type="radio" name="tipo" value="instalacion" class="sr-only"/>
              <div class="opt-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 21h18M5 21V7l7-4 7 4v14"/></svg></div>
              <div class="flex-1">
                <h3 class="font-medium text-lg mb-0.5">Quiero instalar algo nuevo</h3>
                <p class="opt-meta text-sm text-graphite">Reforma, ampliación, cuadro nuevo, domotización, videoportero, instalación con boletín.</p>
              </div>
              <div class="opt-meta text-xs font-mono text-graphite shrink-0 mt-1">presup. a medida</div>
            </label>

            <label class="opt-card" data-opt="mantenimiento" data-step-field="tipo">
              <input type="radio" name="tipo" value="mantenimiento" class="sr-only"/>
              <div class="opt-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg></div>
              <div class="flex-1">
                <h3 class="font-medium text-lg mb-0.5">Quiero mantenimiento periódico</h3>
                <p class="opt-meta text-sm text-graphite">Revisión preventiva anual. Vivienda, comunidad o local comercial.</p>
              </div>
              <div class="opt-meta text-xs font-mono text-graphite shrink-0 mt-1">desde 90 €/año</div>
            </label>

            <label class="opt-card" data-opt="duda" data-step-field="tipo">
              <input type="radio" name="tipo" value="duda" class="sr-only"/>
              <div class="opt-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3M12 17h.01"/></svg></div>
              <div class="flex-1">
                <h3 class="font-medium text-lg mb-0.5">Solo tengo una duda</h3>
                <p class="opt-meta text-sm text-graphite">No estoy seguro de qué necesito. Quiero asesoramiento antes de decidir.</p>
              </div>
              <div class="opt-meta text-xs font-mono text-stock shrink-0 mt-1">gratis</div>
            </label>
          </div>
        </section>

        <!-- ===== STEP 2: Área técnica ===== -->
        <section class="step" data-step="2">
          <div class="eyebrow text-copper mb-4">Paso 02 de 06</div>
          <h2 class="font-serif font-medium leading-[1.05] tracking-[-0.015em] mb-3" style="font-size: clamp(2rem, 4.5vw, 3.25rem);">
            ¿De qué área es?
          </h2>
          <p class="text-graphite text-lg mb-10">Elige la que mejor encaje. Si no estás seguro, marca "Electricidad" — es lo más probable.</p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <label class="opt-card" data-opt="electricidad" data-step-field="area">
              <input type="radio" name="area" value="electricidad" class="sr-only"/>
              <div class="opt-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8Z"/></svg></div>
              <div class="flex-1">
                <h3 class="font-medium mb-0.5">Electricidad</h3>
                <p class="opt-meta text-xs text-graphite">Cuadro, enchufes, mecanismos, luz</p>
              </div>
            </label>
            <label class="opt-card" data-opt="teleco" data-step-field="area">
              <input type="radio" name="area" value="teleco" class="sr-only"/>
              <div class="opt-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h.01M2 8.82a15 15 0 0 1 20 0M5 12.86a10 10 0 0 1 14 0M8.5 16.43a5 5 0 0 1 7 0"/></svg></div>
              <div class="flex-1">
                <h3 class="font-medium mb-0.5">Telecomunicaciones</h3>
                <p class="opt-meta text-xs text-graphite">Antena, fibra, redes, telefonía</p>
              </div>
            </label>
            <label class="opt-card" data-opt="domotica" data-step-field="area">
              <input type="radio" name="area" value="domotica" class="sr-only"/>
              <div class="opt-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></div>
              <div class="flex-1">
                <h3 class="font-medium mb-0.5">Domótica</h3>
                <p class="opt-meta text-xs text-graphite">Shelly, Hue, Aqara, escenas</p>
              </div>
            </label>
            <label class="opt-card" data-opt="automatismos" data-step-field="area">
              <input type="radio" name="area" value="automatismos" class="sr-only"/>
              <div class="opt-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg></div>
              <div class="flex-1">
                <h3 class="font-medium mb-0.5">Automatismos</h3>
                <p class="opt-meta text-xs text-graphite">Persianas, puerta garaje, motores</p>
              </div>
            </label>
          </div>
        </section>

        <!-- ===== STEP 3: Cuéntanoslo ===== -->
        <section class="step" data-step="3">
          <div class="eyebrow text-copper mb-4">Paso 03 de 06</div>
          <h2 class="font-serif font-medium leading-[1.05] tracking-[-0.015em] mb-3" style="font-size: clamp(2rem, 4.5vw, 3.25rem);">
            Cuéntanos qué pasa.
          </h2>
          <p class="text-graphite text-lg mb-8">Describe el problema con tus propias palabras. Cuanto más detalle nos des, mejor llegamos preparados.</p>

          <div class="space-y-5">
            <div>
              <label class="text-sm font-medium mb-2 block">Descripción <span class="text-warn">*</span></label>
              <textarea class="field-input" id="descripcion" placeholder="Por ejemplo: 'Esta mañana al enchufar el microondas saltó el automático. Lo subí y vuelve a saltar a los pocos minutos. La nevera y la lavadora siguen funcionando'." required></textarea>
              <div class="text-xs text-graphite mt-1.5">Mínimo 20 caracteres · <span data-char-count>0</span> escritos</div>
            </div>

            <div>
              <label class="text-sm font-medium mb-2 block">Adjuntar fotos <span class="text-graphite font-normal">(opcional pero recomendado)</span></label>
              <div class="dropzone" onclick="document.getElementById('file-input').click()">
                <div class="w-12 h-12 mx-auto rounded-full bg-paper grid place-items-center mb-3">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="text-copper"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
                </div>
                <div class="font-medium text-sm mb-1">Arrastra fotos o haz clic para subirlas</div>
                <div class="text-xs text-graphite">JPG, PNG hasta 10 MB · máximo 5 fotos</div>
                <input type="file" id="file-input" multiple accept="image/*" class="hidden"/>
              </div>
            </div>

            <div class="bg-paper-3 rounded-xl p-4 text-sm">
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-full bg-electric/10 grid place-items-center text-electric shrink-0">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
                </div>
                <div>
                  <strong class="text-ink">Una foto del cuadro eléctrico nos ayuda muchísimo.</strong>
                  <p class="text-graphite mt-0.5">Si puedes hacerla con seguridad (sin tocar nada), nos ahorra una visita en muchos casos.</p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- ===== STEP 4: Dónde y cuándo ===== -->
        <section class="step" data-step="4">
          <div class="eyebrow text-copper mb-4">Paso 04 de 06</div>
          <h2 class="font-serif font-medium leading-[1.05] tracking-[-0.015em] mb-3" style="font-size: clamp(2rem, 4.5vw, 3.25rem);">
            ¿Dónde y cuándo?
          </h2>
          <p class="text-graphite text-lg mb-8">Para mandar al técnico más cercano y avisar con margen.</p>

          <div class="space-y-5">
            <div class="grid sm:grid-cols-3 gap-3">
              <div class="sm:col-span-1">
                <label class="text-sm font-medium mb-2 block">Código postal <span class="text-warn">*</span></label>
                <input type="text" class="field-input font-mono" placeholder="23071" maxlength="5" pattern="[0-9]{5}" required/>
              </div>
              <div class="sm:col-span-2">
                <label class="text-sm font-medium mb-2 block">Localidad <span class="text-warn">*</span></label>
                <input type="text" class="field-input" placeholder="Jaén" required/>
              </div>
            </div>

            <div>
              <label class="text-sm font-medium mb-2 block">Dirección <span class="text-warn">*</span></label>
              <input type="text" class="field-input" placeholder="Calle, número, piso y puerta" required/>
            </div>

            <div>
              <label class="text-sm font-medium mb-2 block">¿Cómo de urgente es?</label>
              <div class="grid grid-cols-3 gap-2">
                <label class="opt-card !p-3" data-opt="urgente" data-step-field="urgencia">
                  <input type="radio" name="urgencia" value="urgente" class="sr-only"/>
                  <div class="text-center w-full">
                    <div class="text-warn font-medium mb-0.5 text-sm">Urgente</div>
                    <div class="opt-meta text-[11px] text-graphite">Hoy mismo</div>
                  </div>
                </label>
                <label class="opt-card !p-3" data-opt="esta-semana" data-step-field="urgencia">
                  <input type="radio" name="urgencia" value="esta-semana" class="sr-only"/>
                  <div class="text-center w-full">
                    <div class="font-medium mb-0.5 text-sm">Esta semana</div>
                    <div class="opt-meta text-[11px] text-graphite">2-5 días</div>
                  </div>
                </label>
                <label class="opt-card !p-3" data-opt="planificable" data-step-field="urgencia">
                  <input type="radio" name="urgencia" value="planificable" class="sr-only"/>
                  <div class="text-center w-full">
                    <div class="font-medium mb-0.5 text-sm">Planificable</div>
                    <div class="opt-meta text-[11px] text-graphite">Sin prisa</div>
                  </div>
                </label>
              </div>
            </div>

            <div>
              <label class="text-sm font-medium mb-2 block">Disponibilidad horaria preferente</label>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                <label class="flex items-center justify-center gap-2 px-3 py-2.5 border border-line rounded-lg cursor-pointer hover:border-ink text-sm">
                  <input type="checkbox" class="w-4 h-4"/> Mañanas
                </label>
                <label class="flex items-center justify-center gap-2 px-3 py-2.5 border border-line rounded-lg cursor-pointer hover:border-ink text-sm">
                  <input type="checkbox" class="w-4 h-4"/> Tardes
                </label>
                <label class="flex items-center justify-center gap-2 px-3 py-2.5 border border-line rounded-lg cursor-pointer hover:border-ink text-sm">
                  <input type="checkbox" class="w-4 h-4"/> Sábados
                </label>
                <label class="flex items-center justify-center gap-2 px-3 py-2.5 border border-line rounded-lg cursor-pointer hover:border-ink text-sm">
                  <input type="checkbox" class="w-4 h-4"/> Cualquier día
                </label>
              </div>
            </div>
          </div>
        </section>

        <!-- ===== STEP 5: Tus datos ===== -->
        <section class="step" data-step="5">
          <div class="eyebrow text-copper mb-4">Paso 05 de 06</div>
          <h2 class="font-serif font-medium leading-[1.05] tracking-[-0.015em] mb-3" style="font-size: clamp(2rem, 4.5vw, 3.25rem);">
            ¿Cómo te llamamos?
          </h2>
          <p class="text-graphite text-lg mb-8">Te contactaremos en menos de 4 horas hábiles para confirmar la visita.</p>

          <div class="space-y-5">
            <div>
              <label class="text-sm font-medium mb-2 block">Nombre completo <span class="text-warn">*</span></label>
              <input type="text" class="field-input" placeholder="Antonio García" required/>
            </div>
            <div class="grid sm:grid-cols-2 gap-3">
              <div>
                <label class="text-sm font-medium mb-2 block">Teléfono <span class="text-warn">*</span></label>
                <input type="tel" class="field-input font-mono" placeholder="600 123 456" required/>
              </div>
              <div>
                <label class="text-sm font-medium mb-2 block">Email</label>
                <input type="email" class="field-input" placeholder="tu@correo.com"/>
              </div>
            </div>
            <div>
              <label class="text-sm font-medium mb-2 block">¿Cómo prefieres que te contactemos?</label>
              <div class="grid grid-cols-3 gap-2">
                <label class="opt-card !p-3" data-opt="llamada" data-step-field="contacto">
                  <input type="radio" name="contacto" value="llamada" class="sr-only"/>
                  <div class="text-center w-full"><div class="font-medium text-sm">Llamada</div></div>
                </label>
                <label class="opt-card !p-3" data-opt="whatsapp" data-step-field="contacto">
                  <input type="radio" name="contacto" value="whatsapp" class="sr-only"/>
                  <div class="text-center w-full"><div class="font-medium text-sm">WhatsApp</div></div>
                </label>
                <label class="opt-card !p-3" data-opt="email" data-step-field="contacto">
                  <input type="radio" name="contacto" value="email" class="sr-only"/>
                  <div class="text-center w-full"><div class="font-medium text-sm">Email</div></div>
                </label>
              </div>
            </div>
            <label class="flex items-start gap-3 mt-2 cursor-pointer">
              <input type="checkbox" class="w-4 h-4 mt-1" required/>
              <span class="text-sm text-graphite leading-relaxed">
                He leído y acepto la <a href="/pages/legal/privacidad.html" class="link-underline text-ink">política de privacidad</a> y el tratamiento de mis datos para gestionar esta solicitud.
              </span>
            </label>
          </div>
        </section>

        <!-- ===== STEP 6: Resumen ===== -->
        <section class="step" data-step="6">
          <div class="eyebrow text-copper mb-4">Paso 06 de 06</div>
          <h2 class="font-serif font-medium leading-[1.05] tracking-[-0.015em] mb-3" style="font-size: clamp(2rem, 4.5vw, 3.25rem);">
            Revisa y envía.
          </h2>
          <p class="text-graphite text-lg mb-8">Comprueba que todo es correcto. Después de enviar recibirás un código de seguimiento.</p>

          <div class="bg-white border border-line rounded-2xl divide-y divide-line">
            <div class="p-5 flex items-start justify-between gap-4">
              <div>
                <div class="text-xs font-mono text-graphite uppercase tracking-wider mb-1">Tipo de servicio</div>
                <div class="font-medium" data-summary="tipo">—</div>
              </div>
              <button class="text-xs text-copper hover:underline" data-edit="1">Editar</button>
            </div>
            <div class="p-5 flex items-start justify-between gap-4">
              <div>
                <div class="text-xs font-mono text-graphite uppercase tracking-wider mb-1">Área técnica</div>
                <div class="font-medium" data-summary="area">—</div>
              </div>
              <button class="text-xs text-copper hover:underline" data-edit="2">Editar</button>
            </div>
            <div class="p-5 flex items-start justify-between gap-4">
              <div class="flex-1">
                <div class="text-xs font-mono text-graphite uppercase tracking-wider mb-1">Descripción</div>
                <div class="text-sm leading-relaxed" data-summary="descripcion">—</div>
              </div>
              <button class="text-xs text-copper hover:underline" data-edit="3">Editar</button>
            </div>
            <div class="p-5 flex items-start justify-between gap-4">
              <div>
                <div class="text-xs font-mono text-graphite uppercase tracking-wider mb-1">Dónde y cuándo</div>
                <div class="font-medium" data-summary="ubicacion">—</div>
                <div class="text-sm text-graphite" data-summary="urgencia">—</div>
              </div>
              <button class="text-xs text-copper hover:underline" data-edit="4">Editar</button>
            </div>
            <div class="p-5 flex items-start justify-between gap-4">
              <div>
                <div class="text-xs font-mono text-graphite uppercase tracking-wider mb-1">Contacto</div>
                <div class="font-medium" data-summary="contacto">—</div>
              </div>
              <button class="text-xs text-copper hover:underline" data-edit="5">Editar</button>
            </div>
          </div>

          <div class="mt-6 p-4 rounded-xl bg-stock/5 border border-stock/30 flex items-start gap-3">
            <div class="w-8 h-8 rounded-full bg-stock text-paper grid place-items-center shrink-0">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>
            </div>
            <div class="text-sm">
              <strong class="text-ink">Enviar es gratis y sin compromiso.</strong>
              <p class="text-graphite mt-0.5">Te llamamos en menos de 4 horas hábiles. Si lo que necesitas se resuelve sin venir, te lo decimos sin cobrarte nada.</p>
            </div>
          </div>
        </section>

        <!-- ===== NAVIGATION BUTTONS ===== -->
        <div class="mt-12 flex items-center justify-between gap-4">
          <button id="btn-prev" class="btn btn-ghost" disabled>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
            Atrás
          </button>
          <button id="btn-next" class="btn btn-primary">
            Siguiente
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </button>
          <button id="btn-submit" class="btn btn-primary hidden">
            Enviar solicitud
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- ============ SIDEBAR LATERAL (estado, info útil) ============ -->
    <aside class="bg-ink text-paper hidden lg:block">
      <div class="sticky top-[73px] p-8 space-y-7">
        <div>
          <div class="eyebrow text-filament mb-3">Tu solicitud</div>
          <p class="text-paper/60 text-sm leading-relaxed">Se va construyendo a medida que respondes. Puedes editar cualquier paso desde el resumen final.</p>
        </div>

        <!-- Mini-summary live -->
        <div class="space-y-3 text-sm">
          <div class="pb-3 border-b border-white/10 opacity-50" id="mini-1">
            <div class="text-[11px] font-mono uppercase tracking-wider text-paper/50 mb-1">01 · Tipo</div>
            <div data-summary-mini="tipo">Por completar</div>
          </div>
          <div class="pb-3 border-b border-white/10 opacity-50" id="mini-2">
            <div class="text-[11px] font-mono uppercase tracking-wider text-paper/50 mb-1">02 · Área</div>
            <div data-summary-mini="area">Por completar</div>
          </div>
          <div class="pb-3 border-b border-white/10 opacity-50" id="mini-3">
            <div class="text-[11px] font-mono uppercase tracking-wider text-paper/50 mb-1">03 · Descripción</div>
            <div data-summary-mini="descripcion">Por completar</div>
          </div>
          <div class="pb-3 border-b border-white/10 opacity-50" id="mini-4">
            <div class="text-[11px] font-mono uppercase tracking-wider text-paper/50 mb-1">04 · Ubicación</div>
            <div data-summary-mini="ubicacion">Por completar</div>
          </div>
          <div class="pb-3 opacity-50" id="mini-5">
            <div class="text-[11px] font-mono uppercase tracking-wider text-paper/50 mb-1">05 · Contacto</div>
            <div data-summary-mini="contacto">Por completar</div>
          </div>
        </div>

        <div class="filament-line"></div>

        <!-- Trust signals -->
        <div class="space-y-3 text-sm">
          <div class="flex items-center gap-3 text-paper/80">
            <span class="w-7 h-7 rounded-full bg-white/5 grid place-items-center text-filament"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></span>
            Respuesta en &lt;4 horas
          </div>
          <div class="flex items-center gap-3 text-paper/80">
            <span class="w-7 h-7 rounded-full bg-white/5 grid place-items-center text-filament"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4"/><path d="M21 12c0 4.97-4.03 9-9 9s-9-4.03-9-9 4.03-9 9-9c2.39 0 4.68.94 6.36 2.64"/></svg></span>
            Sin compromiso
          </div>
          <div class="flex items-center gap-3 text-paper/80">
            <span class="w-7 h-7 rounded-full bg-white/5 grid place-items-center text-filament"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span>
            Datos cifrados
          </div>
        </div>

        <div class="bg-white/5 rounded-xl p-4 text-xs text-paper/70 border border-white/10">
          <strong class="text-paper">¿Prefieres llamar?</strong>
          <p class="mt-1">Marca al <a href="tel:953000000" class="text-filament">953 00 00 00</a> en horario L-V 8:00-18:30.</p>
        </div>
      </div>
    </aside>
  </main>

  <script>
    // ============ STEPPER LOGIC ============
    let currentStep = 1;
    const totalSteps = 6;
    const state = { tipo: null, area: null, descripcion: null, urgencia: null, contacto: null };

    const labels = {
      tipo: { averia: 'Avería', instalacion: 'Instalación nueva', mantenimiento: 'Mantenimiento periódico', duda: 'Duda / asesoramiento' },
      area: { electricidad: 'Electricidad', teleco: 'Telecomunicaciones', domotica: 'Domótica', automatismos: 'Automatismos' },
      urgencia: { urgente: 'Urgente · hoy mismo', 'esta-semana': 'Esta semana', planificable: 'Planificable' },
      contacto: { llamada: 'Llamada telefónica', whatsapp: 'WhatsApp', email: 'Email' },
    };

    const $ = (s, c=document) => c.querySelector(s);
    const $$ = (s, c=document) => [...c.querySelectorAll(s)];

    // Selección de tarjetas opt-card
    $$('.opt-card').forEach(card => {
      card.addEventListener('click', () => {
        const field = card.dataset.stepField;
        const value = card.dataset.opt;
        // Deseleccionar las del mismo grupo
        $$(`.opt-card[data-step-field="${field}"]`).forEach(c => c.classList.remove('is-selected'));
        card.classList.add('is-selected');
        const input = card.querySelector('input');
        if (input) input.checked = true;
        state[field] = value;
        updateMini();
      });
    });

    // Char count
    const desc = $('#descripcion');
    if (desc) desc.addEventListener('input', () => {
      $('[data-char-count]').textContent = desc.value.length;
      state.descripcion = desc.value;
      updateMini();
    });

    function updateMini() {
      const set = (key, text, stepNum) => {
        const el = $(`[data-summary-mini="${key}"]`);
        if (el && text) {
          el.textContent = text;
          el.classList.add('text-paper');
          $(`#mini-${stepNum}`).classList.remove('opacity-50');
        }
      };
      if (state.tipo) set('tipo', labels.tipo[state.tipo], 1);
      if (state.area) set('area', labels.area[state.area], 2);
      if (state.descripcion) {
        const trimmed = state.descripcion.length > 60 ? state.descripcion.slice(0, 60) + '...' : state.descripcion;
        set('descripcion', trimmed, 3);
      }
      if (state.urgencia) set('ubicacion', labels.urgencia[state.urgencia], 4);
      if (state.contacto) set('contacto', labels.contacto[state.contacto], 5);
    }

    function showStep(n) {
      $$('.step').forEach(s => s.classList.toggle('is-active', +s.dataset.step === n));
      $$('.seg').forEach(s => {
        s.classList.remove('is-current', 'is-done');
        if (+s.dataset.seg < n) s.classList.add('is-done');
        if (+s.dataset.seg === n) s.classList.add('is-current');
      });
      $('[data-current-step]').textContent = n;
      $('#mobile-progress').style.width = `${(n / totalSteps) * 100}%`;
      $('#btn-prev').disabled = n === 1;
      $('#btn-next').classList.toggle('hidden', n === totalSteps);
      $('#btn-submit').classList.toggle('hidden', n !== totalSteps);
      if (n === totalSteps) populateSummary();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function validateStep(n) {
      if (n === 1 && !state.tipo) return alert('Elige una opción para seguir.'), false;
      if (n === 2 && !state.area) return alert('Elige el área técnica.'), false;
      if (n === 3 && (!state.descripcion || state.descripcion.length < 20)) return alert('La descripción debe tener al menos 20 caracteres.'), false;
      // Pasos 4 y 5 validamos por required nativo
      return true;
    }

    function populateSummary() {
      $('[data-summary="tipo"]').textContent = labels.tipo[state.tipo] || '—';
      $('[data-summary="area"]').textContent = labels.area[state.area] || '—';
      $('[data-summary="descripcion"]').textContent = state.descripcion || '—';
      $('[data-summary="urgencia"]').textContent = labels.urgencia[state.urgencia] || '—';
      $('[data-summary="contacto"]').textContent = labels.contacto[state.contacto] || '—';
      const cp = document.querySelector('[data-step="4"] input[type="text"]').value || '';
      const loc = document.querySelectorAll('[data-step="4"] input[type="text"]')[1].value || '';
      $('[data-summary="ubicacion"]').textContent = (cp && loc) ? `${cp} · ${loc}` : '—';
    }

    $('#btn-next').addEventListener('click', () => {
      if (!validateStep(currentStep)) return;
      if (currentStep < totalSteps) { currentStep++; showStep(currentStep); }
    });
    $('#btn-prev').addEventListener('click', () => {
      if (currentStep > 1) { currentStep--; showStep(currentStep); }
    });
    $('#btn-submit').addEventListener('click', () => {
      // En un proyecto real iría aquí el POST al backend.
      window.location.href = '/pages/servicios/solicitud-confirmacion.html';
    });
    $$('[data-edit]').forEach(b => b.addEventListener('click', () => {
      currentStep = +b.dataset.edit;
      showStep(currentStep);
    }));
  </script>
  <script src="/.assets/js/component-loader.js"></script>
  <script src="/.data/api.js"></script>
  <script src="/.assets/js/backend-integration.js"></script>
  <script src="/.assets/js/catalog-ui.js"></script>
</body>
</html>
