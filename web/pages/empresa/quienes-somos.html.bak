      <article class="md:col-span-4 group">
        <div class="aspect-square rounded-2xl overflow-hidden bg-paper-2 relative mb-4">
          <img src="https://images.unsplash.com/photo-1632833239869-a37e3a5806d2?auto=format&fit=crop&w=800&q=80" alt="" class="w-full h-full object-cover" loading="lazy" onerror="this.style.display='none'"/>
          <div class="absolute top-4 left-4">
            <span class="pill bg-warn text-paper text-[10px]">Avería urgente</span>
