<!DOCTYPE html>
<html lang="es"><head>
  <base href="../../">
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Pedido recurrente · Mi área · GarperLux</title>
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
<script src="https://cdn.tailwindcss.com"></script>
<script>tailwind.config={theme:{extend:{colors:{ink:'#0B0D12','ink-soft':'#1C1F26',graphite:'#40454F',paper:'#F7F3EC','paper-2':'#EFE9DE','paper-3':'#E4DCCA',line:'#E5DED0',filament:'#E8A545','filament-glow':'#FFC878',copper:'#B8753A',electric:'#1E3A8A',stock:'#16A34A',warn:'#DC2626'},fontFamily:{serif:['Fraunces','Georgia','serif'],sans:['Inter','system-ui','sans-serif'],mono:['JetBrains Mono','monospace']}}}};</script>
<link rel="stylesheet" href="../../assets/css/styles.css" />
<style>
.field{width:100%;padding:.85rem 1rem;background:white;border:1.5px solid var(--line);border-radius:10px;font-size:14px;color:var(--ink)}
.field:focus{outline:none;border-color:var(--ink)}
.nav-item{display:flex;align-items:center;gap:.75rem;padding:.65rem .85rem;border-radius:8px;font-size:14px;color:var(--graphite);transition:all .15s}
.nav-item:hover{background:var(--paper-2);color:var(--ink)}
.nav-item.is-active{background:var(--ink);color:var(--paper);font-weight:500}
.freq-card{display:block;padding:1.1rem 1.3rem;border:1.5px solid var(--line);border-radius:14px;background:white;cursor:pointer;transition:all .15s;text-align:center}
.freq-card:hover{border-color:var(--graphite)}
.freq-card input{display:none}
.freq-card.is-on{border-color:var(--ink);background:var(--paper-2);box-shadow:0 0 0 3px rgba(11,13,18,.05)}
.day-pill{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border:1.5px solid var(--line);background:white;border-radius:8px;cursor:pointer;font-size:13px;font-weight:500;color:var(--graphite);transition:all .15s}
.day-pill:hover{border-color:var(--graphite)}
.day-pill input{display:none}
.day-pill.is-on{background:var(--ink);color:var(--paper);border-color:var(--ink)}
</style>
</head>
<body class="bg-paper text-ink">
  <div data-component="site-header"></div>

<div class="container-x pt-5 pb-2"><nav class="text-xs font-mono text-graphite flex items-center gap-2 flex-wrap"><a href="../../index.html" class="hover:text-ink">Inicio</a><span class="opacity-50">/</span><a href="area-personal.html" class="hover:text-ink">Mi área</a><span class="opacity-50">/</span><a href="repetir-compra.html" class="hover:text-ink">Repetir compra</a><span class="opacity-50">/</span><span class="text-ink">Pedido recurrente</span></nav></div>

<section class="container-x py-6 pb-20"><div class="grid lg:grid-cols-[280px_1fr] gap-8 lg:gap-10">
<aside id="glx-sidebar" class="lg:sticky lg:top-6 lg:self-start" data-active="repetir-compra"></aside>

<main class="max-w-3xl">
  <a href="repetir-compra.html" class="text-sm text-graphite hover:text-ink flex items-center gap-2 mb-5"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>Volver a Repetir compra</a>

  <div class="mb-8">
    <div class="eyebrow text-copper mb-2">Automatización pro</div>
    <h1 class="font-serif font-medium leading-[0.96]" style="font-size: clamp(2rem, 4.5vw, 3rem);">Pedido recurrente.</h1>
    <p class="text-graphite mt-2 max-w-xl">Define qué quieres recibir y cada cuánto. Te enviamos un email para confirmar antes de cada salida. Si no contestas en 24 h, sale igualmente.</p>
  </div>

  <form class="space-y-6">

    <!-- Nombre -->
    <div class="bg-white border border-line rounded-2xl p-6">
      <h2 class="font-serif text-xl font-medium mb-1">1 · Nombre del pedido recurrente</h2>
      <p class="text-sm text-graphite mb-4">Para identificarlo cuando tengas varios.</p>
      <input type="text" class="field" placeholder="Ej. Reposición taller mensual"/>
    </div>

    <!-- Frecuencia -->
    <div class="bg-white border border-line rounded-2xl p-6">
      <h2 class="font-serif text-xl font-medium mb-1">2 · ¿Cada cuánto?</h2>
      <p class="text-sm text-graphite mb-4">Lo más habitual es mensual, pero si trabajas obras grandes, puedes ponerlo cada dos semanas.</p>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-5">
        <label class="freq-card"><input type="radio" name="freq"/><div class="font-medium">Semanal</div><div class="text-xs text-graphite mt-1">Cada 7 días</div></label>
        <label class="freq-card"><input type="radio" name="freq"/><div class="font-medium">Quincenal</div><div class="text-xs text-graphite mt-1">Cada 14 días</div></label>
        <label class="freq-card is-on"><input type="radio" name="freq" checked/><div class="font-medium">Mensual</div><div class="text-xs text-graphite mt-1">Cada 30 días</div></label>
        <label class="freq-card"><input type="radio" name="freq"/><div class="font-medium">Personalizado</div><div class="text-xs text-graphite mt-1">Tú decides</div></label>
      </div>

      <div>
        <label class="text-xs font-mono text-graphite uppercase tracking-wider mb-2 block">Día del mes preferido para la salida</label>
        <div class="flex flex-wrap gap-1.5 mb-3">
          <label class="day-pill"><input type="radio" name="dia"/>1</label>
          <label class="day-pill"><input type="radio" name="dia"/>2</label>
          <label class="day-pill"><input type="radio" name="dia"/>3</label>
          <label class="day-pill is-on"><input type="radio" name="dia" checked/>5</label>
          <label class="day-pill"><input type="radio" name="dia"/>10</label>
          <label class="day-pill"><input type="radio" name="dia"/>15</label>
          <label class="day-pill"><input type="radio" name="dia"/>20</label>
          <label class="day-pill"><input type="radio" name="dia"/>25</label>
        </div>
        <div class="text-xs text-graphite">Si cae en festivo, sale el siguiente día hábil.</div>
      </div>
    </div>

    <!-- Productos -->
    <div class="bg-white border border-line rounded-2xl overflow-hidden">
      <div class="p-6 border-b border-line">
        <h2 class="font-serif text-xl font-medium mb-1">3 · Productos del recurrente</h2>
        <p class="text-sm text-graphite">5 productos · 150 unidades · 280,10 €</p>
      </div>
      <div class="divide-y divide-line">
        <div class="p-5 grid grid-cols-[auto_1fr_auto_auto] gap-4 items-center">
          <div class="w-12 h-12 rounded-lg bg-paper-2 grid place-items-center text-graphite/40"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="4" y="4" width="16" height="16" rx="2"/></svg></div>
          <div><div class="font-medium">Interruptor Simón 27 10A blanco</div><div class="text-xs text-graphite font-mono">SKU 27101-31</div></div>
          <div class="flex items-center bg-paper-2 rounded-full overflow-hidden"><button type="button" class="w-7 h-7 grid place-items-center hover:bg-paper-3">−</button><input type="number" value="25" class="w-10 text-center bg-transparent font-mono text-sm font-medium outline-none"/><button type="button" class="w-7 h-7 grid place-items-center hover:bg-paper-3">+</button></div>
          <button type="button" class="text-xs text-warn hover:underline">Quitar</button>
        </div>
        <div class="p-5 grid grid-cols-[auto_1fr_auto_auto] gap-4 items-center">
          <div class="w-12 h-12 rounded-lg bg-paper-2 grid place-items-center text-graphite/40"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><circle cx="12" cy="12" r="9"/></svg></div>
          <div><div class="font-medium">Cinta aislante 3M 10m blanca</div><div class="text-xs text-graphite font-mono">SKU 3M-CA-10W</div></div>
          <div class="flex items-center bg-paper-2 rounded-full overflow-hidden"><button type="button" class="w-7 h-7 grid place-items-center hover:bg-paper-3">−</button><input type="number" value="20" class="w-10 text-center bg-transparent font-mono text-sm font-medium outline-none"/><button type="button" class="w-7 h-7 grid place-items-center hover:bg-paper-3">+</button></div>
          <button type="button" class="text-xs text-warn hover:underline">Quitar</button>
        </div>
        <div class="p-5 grid grid-cols-[auto_1fr_auto_auto] gap-4 items-center">
          <div class="w-12 h-12 rounded-lg bg-paper-2 grid place-items-center text-graphite/40"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/></svg></div>
          <div><div class="font-medium">Clema Wago 222 3 hilos (caja 50)</div><div class="text-xs text-graphite font-mono">SKU WG-222-415</div></div>
          <div class="flex items-center bg-paper-2 rounded-full overflow-hidden"><button type="button" class="w-7 h-7 grid place-items-center hover:bg-paper-3">−</button><input type="number" value="100" class="w-10 text-center bg-transparent font-mono text-sm font-medium outline-none"/><button type="button" class="w-7 h-7 grid place-items-center hover:bg-paper-3">+</button></div>
          <button type="button" class="text-xs text-warn hover:underline">Quitar</button>
        </div>
        <div class="p-5 grid grid-cols-[auto_1fr_auto_auto] gap-4 items-center">
          <div class="w-12 h-12 rounded-lg bg-paper-2 grid place-items-center text-graphite/40"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M12 2L8 6v6l4 4 4-4V6z"/></svg></div>
          <div><div class="font-medium">Magnetotérmico Schneider iC60N 16A</div><div class="text-xs text-graphite font-mono">SKU A9F74216</div></div>
          <div class="flex items-center bg-paper-2 rounded-full overflow-hidden"><button type="button" class="w-7 h-7 grid place-items-center hover:bg-paper-3">−</button><input type="number" value="5" class="w-10 text-center bg-transparent font-mono text-sm font-medium outline-none"/><button type="button" class="w-7 h-7 grid place-items-center hover:bg-paper-3">+</button></div>
          <button type="button" class="text-xs text-warn hover:underline">Quitar</button>
        </div>
      </div>
      <div class="p-4 bg-paper-2 border-t border-line">
        <button type="button" class="text-sm text-copper hover:underline">+ Añadir más productos al recurrente</button>
      </div>
    </div>

    <!-- Envío y pago -->
    <div class="bg-white border border-line rounded-2xl p-6">
      <h2 class="font-serif text-xl font-medium mb-5">4 · Envío y pago</h2>
      <div class="space-y-4">
        <div>
          <label class="text-xs font-mono text-graphite uppercase tracking-wider mb-1.5 block">Dirección de envío</label>
          <select class="field"><option>Polígono Los Olivares, nave 24 · 23009 Jaén (taller)</option><option>Calle Bernabé Soriano 12 · 23001 Jaén (obra activa)</option><option>+ Nueva dirección</option></select>
        </div>
        <div>
          <label class="text-xs font-mono text-graphite uppercase tracking-wider mb-1.5 block">Método de pago</label>
          <select class="field"><option>Aplazado 30 días (cuenta pro)</option><option>Visa •••• 4242</option><option>Transferencia</option></select>
        </div>
        <div>
          <label class="text-xs font-mono text-graphite uppercase tracking-wider mb-1.5 block">Velocidad de envío</label>
          <select class="field"><option>Estándar 24-48 h (gratis al ser recurrente)</option><option>Recogida en almacén Jaén</option></select>
        </div>
      </div>
    </div>

    <!-- Aviso confirmación -->
    <div class="bg-stock/5 border border-stock/30 rounded-2xl p-5 flex items-start gap-3">
      <span class="w-10 h-10 rounded-full bg-stock text-paper grid place-items-center shrink-0"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6 12 13 2 6"/></svg></span>
      <div>
        <div class="font-medium">Email 48 h antes de cada salida</div>
        <p class="text-sm text-graphite mt-1">Te avisamos para que ajustes cantidades, pauses una entrega concreta o canceles definitivamente. Si no respondes, sale con la última configuración.</p>
      </div>
    </div>

    <!-- Próximas salidas -->
    <div class="bg-paper-2 border border-line rounded-2xl p-6">
      <h2 class="font-serif text-lg font-medium mb-4">Próximas salidas previstas</h2>
      <div class="grid sm:grid-cols-3 gap-3 text-center">
        <div class="bg-white rounded-xl p-4 border-2 border-filament"><div class="text-[10px] font-mono uppercase text-filament">Próxima</div><div class="font-serif text-xl font-medium mt-1">05/05/2026</div><div class="text-xs text-graphite font-mono mt-1">280,10 €</div></div>
        <div class="bg-white rounded-xl p-4 border border-line"><div class="text-[10px] font-mono uppercase text-graphite">Siguiente</div><div class="font-serif text-xl font-medium mt-1">05/06/2026</div><div class="text-xs text-graphite font-mono mt-1">~280,10 €</div></div>
        <div class="bg-white rounded-xl p-4 border border-line"><div class="text-[10px] font-mono uppercase text-graphite">Tercera</div><div class="font-serif text-xl font-medium mt-1">05/07/2026</div><div class="text-xs text-graphite font-mono mt-1">~280,10 €</div></div>
      </div>
    </div>

    <!-- Acciones -->
    <div class="flex justify-between flex-wrap gap-3 pt-4">
      <a href="repetir-compra.html" class="btn btn-ghost">Cancelar</a>
      <button class="btn btn-primary">Activar pedido recurrente<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg></button>
    </div>
  </form>
</main>
</div></section>
  <div data-component="site-footer"></div>

<script src="../../assets/js/main.js"></script><script src="../../assets/js/auth.js"></script>
<script>
if(glxRequireAuth()){const u=glxGetUser();if(u.role!=='pro'){location.href='area-personal.html';}else{document.querySelector('[data-current-name]') && (document.querySelector('[data-current-name]').textContent=u.name);const sb=document.getElementById('glx-sidebar');sb.innerHTML=glxRenderSidebar(sb.dataset.active);}}
document.querySelectorAll('.freq-card,.day-pill').forEach(c=>{c.addEventListener('click',()=>{const i=c.querySelector('input');if(!i)return;document.querySelectorAll(`input[name="${i.name}"]`).forEach(o=>o.closest('.freq-card,.day-pill').classList.remove('is-on'));i.checked=true;c.classList.add('is-on');});});
</script>
  <script src="../../assets/js/component-loader.js"></script>
  <script src="../../data/api.js"></script>
  <script src="../../assets/js/backend-integration.js"></script>
  <script src="../../assets/js/catalog-ui.js"></script>
</body></html>
