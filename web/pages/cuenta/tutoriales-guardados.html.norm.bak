<!DOCTYPE html>
<html lang="es"><head>
  <base href="/.">
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Tutoriales guardados · Mi área · GarperLux</title>
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
<script src="https://cdn.tailwindcss.com"></script>
<script>tailwind.config={theme:{extend:{colors:{ink:'#0B0D12','ink-soft':'#1C1F26',graphite:'#40454F',paper:'#F7F3EC','paper-2':'#EFE9DE','paper-3':'#E4DCCA',line:'#E5DED0',filament:'#E8A545','filament-glow':'#FFC878',copper:'#B8753A',electric:'#1E3A8A',stock:'#16A34A',warn:'#DC2626',caution:'#D97706'},fontFamily:{serif:['Fraunces','Georgia','serif'],sans:['Inter','system-ui','sans-serif'],mono:['JetBrains Mono','monospace']}}}};</script>
<link rel="stylesheet" href="/.assets/css/styles.css" />
<style>.nav-item{display:flex;align-items:center;gap:.75rem;padding:.65rem .85rem;border-radius:8px;font-size:14px;color:var(--graphite);transition:all .15s}.nav-item:hover{background:var(--paper-2);color:var(--ink)}.nav-item.is-active{background:var(--ink);color:var(--paper);font-weight:500}</style>
</head>
<body class="bg-paper text-ink">
  <div data-component="site-header"></div>
<div class="container-x pt-5 pb-2"><nav class="text-xs font-mono text-graphite flex items-center gap-2"><a href="/.index.html" class="hover:text-ink">Inicio</a><span class="opacity-50">/</span><a href="/pages/cuenta/area-personal.html" class="hover:text-ink">Mi área</a><span class="opacity-50">/</span><span class="text-ink">Tutoriales guardados</span></nav></div>

<section class="container-x py-6 pb-20"><div class="grid lg:grid-cols-[280px_1fr] gap-8 lg:gap-10">
<aside id="glx-sidebar" class="lg:sticky lg:top-6 lg:self-start" data-active="tutoriales-guardados"></aside>

<main>
  <div class="mb-8">
    <div class="eyebrow text-copper mb-2">Aprendizaje</div>
    <h1 class="font-serif font-medium leading-[0.96]" style="font-size: clamp(2rem, 4.5vw, 3rem);">Tutoriales guardados.</h1>
    <p class="text-graphite mt-2">7 tutoriales · 2 sin terminar.</p>
  </div>

  <!-- En curso -->
  <h2 class="font-serif text-xl font-medium mb-4">Continúa donde lo dejaste</h2>
  <div class="grid md:grid-cols-2 gap-5 mb-10">
    <a href="/pages/aprender/tutorial.html" class="bg-white border border-line rounded-2xl overflow-hidden hover:border-ink transition-colors group">
      <div class="aspect-[16/9] bg-ink relative"><img src="https://images.unsplash.com/photo-1621905251189-08b45d6a269e?auto=format&fit=crop&w=900&q=80" alt="" class="w-full h-full object-cover opacity-80" loading="lazy" onerror="this.style.display='none'"/>
        <div class="absolute bottom-0 left-0 right-0 h-1 bg-paper-2"><div class="h-full bg-filament" style="width: 65%"></div></div>
      </div>
      <div class="p-5">
        <div class="flex items-center gap-2 mb-2"><span class="pill pill-info text-[10px]">Mecanismos</span><span class="pill pill-caution text-[10px]">Media</span></div>
        <h3 class="font-serif text-xl font-medium leading-snug mb-2">Cambiar un interruptor desgastado sin volverte loco</h3>
        <p class="text-xs text-graphite font-mono">Paso 4 de 6 · 65% completado</p>
      </div>
    </a>
    <a href="/pages/aprender/tutorial.html" class="bg-white border border-line rounded-2xl overflow-hidden hover:border-ink transition-colors group">
      <div class="aspect-[16/9] bg-paper-2 relative grid place-items-center text-graphite/30"><svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="12" cy="12" r="3"/></svg>
        <div class="absolute bottom-0 left-0 right-0 h-1 bg-paper-2"><div class="h-full bg-filament" style="width: 22%"></div></div>
      </div>
      <div class="p-5">
        <div class="flex items-center gap-2 mb-2"><span class="pill pill-info text-[10px]">Videoportero</span></div>
        <h3 class="font-serif text-xl font-medium leading-snug mb-2">Instalar un videoportero con Wi-Fi</h3>
        <p class="text-xs text-graphite font-mono">Paso 1 de 5 · 22% completado</p>
      </div>
    </a>
  </div>

  <!-- Completados -->
  <h2 class="font-serif text-xl font-medium mb-4">Ya completados</h2>
  <div class="grid md:grid-cols-3 gap-4">
    <a href="/pages/aprender/tutorial.html" class="card-tut group">
      <div class="cover aspect-[4/3]" style="background:#E4DCCA;"></div>
      <div class="p-4"><div class="flex items-center gap-2 mb-1"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-stock"><path d="M20 6 9 17l-5-5"/></svg><span class="text-xs text-stock font-medium">Completado</span></div><h3 class="font-serif text-base font-medium leading-snug">Voltios, vatios y amperios en 5 minutos</h3></div>
    </a>
    <a href="/pages/aprender/tutorial.html" class="card-tut group">
      <div class="cover aspect-[4/3]" style="background:#EFE9DE;"></div>
      <div class="p-4"><div class="flex items-center gap-2 mb-1"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-stock"><path d="M20 6 9 17l-5-5"/></svg><span class="text-xs text-stock font-medium">Completado</span></div><h3 class="font-serif text-base font-medium leading-snug">Cómo cortar la luz del circuito correcto</h3></div>
    </a>
    <a href="/pages/aprender/tutorial.html" class="card-tut group">
      <div class="cover aspect-[4/3]" style="background:linear-gradient(135deg,#1C1F26,#0B0D12);"></div>
      <div class="p-4"><div class="flex items-center gap-2 mb-1"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-stock"><path d="M20 6 9 17l-5-5"/></svg><span class="text-xs text-stock font-medium">Completado</span></div><h3 class="font-serif text-base font-medium leading-snug">Qué es un polímetro y cómo usarlo sin miedo</h3></div>
    </a>
    <a href="/pages/aprender/tutorial.html" class="card-tut group">
      <div class="cover aspect-[4/3]" style="background:#EFE9DE;"></div>
      <div class="p-4"><div class="flex items-center gap-2 mb-1"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-stock"><path d="M20 6 9 17l-5-5"/></svg><span class="text-xs text-stock font-medium">Completado</span></div><h3 class="font-serif text-base font-medium leading-snug">Entender la temperatura de color</h3></div>
    </a>
    <a href="/pages/aprender/tutorial.html" class="card-tut group">
      <div class="cover aspect-[4/3]" style="background:#E4DCCA;"></div>
      <div class="p-4"><div class="flex items-center gap-2 mb-1"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-stock"><path d="M20 6 9 17l-5-5"/></svg><span class="text-xs text-stock font-medium">Completado</span></div><h3 class="font-serif text-base font-medium leading-snug">Cambiar un enchufe doble</h3></div>
    </a>
  </div>
</main>
</div></section>
  <div data-component="site-footer"></div>

<script src="/.assets/js/main.js"></script><script src="/.assets/js/auth.js"></script>
<script>if(glxRequireAuth()){const u=glxGetUser();if(u.role==='pro'){location.href='/pages/cuenta/area-personal.html';}else{document.querySelector('[data-current-name]') && (document.querySelector('[data-current-name]').textContent=u.name);const sb=document.getElementById('glx-sidebar');sb.innerHTML=glxRenderSidebar(sb.dataset.active);}}</script>
  <script src="/.assets/js/component-loader.js"></script>
  <script src="/.data/api.js"></script>
  <script src="/.assets/js/backend-integration.js"></script>
  <script src="/.assets/js/catalog-ui.js"></script>
